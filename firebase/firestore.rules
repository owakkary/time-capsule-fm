rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Explorer progression subcollections
      match /explorer/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Preferences subcollection (favorites, settings)
      match /preferences/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Episodes collection - users can only access their own episodes
    match /episodes/{episodeId} {
      // Allow read if user owns the episode
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Allow create if user is setting themselves as owner
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Allow update/delete if user owns the episode
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Listening history - users can only access their own
    match /listeningHistory/{historyId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
